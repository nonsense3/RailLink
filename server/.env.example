# ==============================================================================
# RailLink Master Backend Environment Variables (.env)
# ==============================================================================

PORT=3001
NODE_ENV=development

# Supabase Master Database
SUPABASE_URL=https://cgelhhbquhzeynzwjeub.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary Storage & Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=raillink_uploads

# Machine Learning Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# RapidAPI - Indian Railways / IRCTC Live Train API
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=indian-railway-irctc.p.rapidapi.com

# MapTiler Satellite & HD Rail Vector Map API
MAPTILER_API_KEY=your_maptiler_api_key

# Google Gemini AI - Block Schedule Optimization & Copilot
GEMINI_API_KEY=your_gemini_api_key
