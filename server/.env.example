# =================================================================
# RailLink Server Environment Variables (Template)
# Duplicate this file to .env and insert your real production credentials
# =================================================================

PORT=3001
NODE_ENV=production

# -----------------------------------------------------------------
# Supabase PostgreSQL Database & Realtime
# Get these from: https://supabase.com -> Project Settings -> API
# -----------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# -----------------------------------------------------------------
# Cloudinary Media Storage (Defect Photo Inspections)
# Get these from: https://cloudinary.com -> Dashboard
# -----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------
# Optional Machine Learning Service
# -----------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000

# -----------------------------------------------------------------
# RapidAPI - Indian Railways / IRCTC Live Train API
# -----------------------------------------------------------------
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=indian-railway-irctc.p.rapidapi.com

# -----------------------------------------------------------------
# MapTiler Satellite & HD Rail Vector Map API
# Get key from: https://cloud.maptiler.com
# -----------------------------------------------------------------
MAPTILER_API_KEY=your_maptiler_api_key

# -----------------------------------------------------------------
# Google Gemini AI - Block Schedule Optimization & Copilot
# Get key from: https://aistudio.google.com
# -----------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
