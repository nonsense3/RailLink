# =================================================================
# RailLink Client Environment Variables (Template)
# Duplicate this file to .env and insert your real production credentials
# =================================================================

# Backend API endpoint (relative /api for same-domain or full URL in production)
VITE_API_URL=/api

# Supabase Public Anonymous API Credentials
# Get these from: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# MapTiler Cloud Map API Key (https://cloud.maptiler.com)
VITE_MAPTILER_API_KEY=your_maptiler_api_key

# Google Gemini API Key for Client (https://aistudio.google.com)
VITE_GEMINI_API_KEY=your_gemini_api_key
