# Environment & Sensitive Config Files (NEVER COMMIT PLAINTEXT TO GITHUB)
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# SOPS encrypted versions are SAFE to commit
!**/*.env.enc
!.sops.yaml

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Build Artifacts & Output
dist/
client/dist/
dist-ssr/
build/
*.tsbuildinfo

# Vercel deployment cache
.vercel/

